PORT=3000
DATABASE_URL=postgresql://dashboard:dashboard_pass@localhost:5432/dashboard
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
CORS_ORIGIN=http://localhost:5173

# Звідки читати події gateway: postgres (локальні фейкові дані) або dynamo
EVENT_STORE=postgres
# Потрібні лише для EVENT_STORE=dynamo
AWS_REGION=change_me
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
EVENTS_TABLE=ai-gateway-request-events
# Необов'язково: назва GSI з ключем requestId (без нього пошук події за id перебирає всю таблицю)
EVENTS_REQUEST_ID_INDEX=
